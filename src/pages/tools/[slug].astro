---
import Base from '../../layouts/Base.astro'
import SEO from '../../components/SEO.astro'
import CTASection from '../../components/CTASection.astro'
import { cms, tiptapToHtml } from '../../lib/cms'
import SiteAuditTool from '../../components/tools/SiteAuditTool.astro'

const toolComponents: Record<string, any> = {
  'site-audit': SiteAuditTool,
}

export async function getStaticPaths() {
  const client = cms()
  const result = await client.collection('tool').findMany({ where: { status: 'published' }, limit: 500 })
  const tools = result?.data ?? []
  return tools.map((t: any) => ({ params: { slug: t.slug } }))
}

const { slug } = Astro.params
const client = cms()

const tool = await client.collection('tool').findOne({ where: { slug } })
if (!tool) return Astro.redirect('/404')

const rawBody = typeof tool.body === 'string' ? JSON.parse(tool.body) : tool.body
const bodyHtml = rawBody?.html || tiptapToHtml(rawBody)

const seoTitle = tool.seo?.metaTitle || `${tool.title} — Free Tool | Chris Garlick`
const seoDesc = tool.seo?.metaDescription || tool.description?.slice(0, 155) || ''

const ToolComponent = toolComponents[slug] ?? null

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.title,
  description: tool.description || '',
  applicationCategory: 'WebApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
  author: { '@type': 'Person', name: 'Chris Garlick' },
}
---

<Base>
  <SEO
    slot="head"
    title={seoTitle}
    description={seoDesc}
    canonical={`https://chrisgarlick.com/tools/${slug}`}
    jsonLd={jsonLd}
  />

  <article class="py-20 md:py-24">
    <div class="mx-auto max-w-[720px] px-5 md:px-8">
      <!-- Header -->
      <div class="mb-12">
        <div class="mb-4 flex items-center gap-3">
          {tool.icon && <span class="text-2xl">{tool.icon}</span>}
          {tool.category && (
            <span class="rounded-[3px] bg-bg-muted px-2.5 py-1 font-body text-xs font-medium uppercase tracking-widest text-text-secondary">
              {tool.category}
            </span>
          )}
          <span class="rounded-[3px] bg-accent/10 px-2.5 py-1 font-body text-xs font-medium uppercase tracking-widest text-accent">
            Free
          </span>
        </div>
        <h1 class="mb-4 font-display text-[36px] leading-[1.15] text-text-primary md:text-[48px]">{tool.title}</h1>
        {tool.description && (
          <p class="text-[15px] leading-[1.75] text-text-secondary">{tool.description}</p>
        )}
      </div>

      <!-- CMS body content -->
      {bodyHtml && (
        <div class="prose-custom mb-16 text-base leading-[1.75] text-text-secondary" set:html={bodyHtml} />
      )}
    </div>

    <!-- Interactive tool (full width allowed) -->
    {ToolComponent && (
      <div class="mx-auto max-w-[720px] px-5 md:px-8">
        <ToolComponent />
      </div>
    )}
  </article>

  <CTASection
    heading="Want the full picture?"
    body="I'll run a deep audit on your site and record a personalised walkthrough of the findings. No pitch, just value."
  />
</Base>
