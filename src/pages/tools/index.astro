---
import Base from '../../layouts/Base.astro'
import SEO from '../../components/SEO.astro'
import ToolCard from '../../components/ToolCard.astro'
import CTASection from '../../components/CTASection.astro'
import { cms } from '../../lib/cms'

const client = cms()

const result = await client.collection('tool').findMany({
  where: { status: 'published' },
  orderBy: { sortOrder: 'asc' },
  limit: 50,
})

const tools = result?.data ?? []

const categories = ['All', 'Audit', 'Performance', 'SEO', 'Content', 'AI']
---

<Base>
  <SEO
    slot="head"
    title="Free Website Audit Tools | SEO, Performance & Accessibility | Chris Garlick"
    description="Free tools to audit your website's SEO, accessibility, performance and overall health. Enter any URL and get an instant score with actionable fixes."
    ogImage="https://chrisgarlick.com/media/9b99d6ea-7255-4cc8-a071-3bbc4f9ba26a.webp"
    canonical="https://chrisgarlick.com/tools"
    jsonLd={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Free Tools',
      description: 'Free tools to audit your website health, SEO, accessibility and performance.',
      url: 'https://chrisgarlick.com/tools',
    }}
  />

  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-[1100px] px-5 md:px-8">
      <p class="mb-3 font-body text-xs font-medium uppercase tracking-widest text-text-secondary">Free tools</p>
      <h1 class="mb-4 font-display text-[36px] text-text-primary md:text-[48px]">Tools</h1>
      <p class="mb-12 max-w-[560px] text-[15px] leading-[1.75] text-text-secondary">
        Test your site against real audits. Every tool runs on the same infrastructure I use for client work.
      </p>

      <!-- Category filters -->
      <div class="mb-12 flex flex-wrap gap-2" role="tablist" aria-label="Filter by category">
        {categories.map((cat) => (
          <button
            role="tab"
            aria-selected={cat === 'All' ? 'true' : 'false'}
            data-filter={cat}
            class={`px-3 py-1.5 font-body text-xs font-medium uppercase tracking-widest transition-all duration-200 ${
              cat === 'All'
                ? 'border border-accent bg-accent text-white'
                : 'border border-border bg-bg-muted text-text-secondary hover:text-text-primary hover:border-border-hover'
            }`}
            style="border-radius: 3px;"
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Tools grid -->
      {tools.length > 0 ? (
        <div id="tools-grid" class="grid gap-6 md:grid-cols-2">
          {tools.map((tool) => (
            <ToolCard
              slug={tool.slug}
              title={tool.title}
              description={tool.description}
              icon={tool.icon}
              category={tool.category}
            />
          ))}
        </div>
      ) : (
        <p class="py-12 text-center text-text-secondary">Tools coming soon.</p>
      )}

      <!-- Empty state per filter -->
      <p id="tools-empty" class="hidden py-12 text-center text-text-secondary">
        No tools in this category yet.
      </p>
    </div>
  </section>

  <CTASection />
</Base>

<script>
  const buttons = document.querySelectorAll('[data-filter]')
  const grid = document.getElementById('tools-grid')
  const empty = document.getElementById('tools-empty')
  const cards = grid?.querySelectorAll('[data-category]') ?? []

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter

      buttons.forEach((b) => {
        const isActive = b === btn
        b.setAttribute('aria-selected', isActive ? 'true' : 'false')
        b.className = `px-3 py-1.5 font-body text-xs font-medium uppercase tracking-widest transition-all duration-200 ${
          isActive
            ? 'border border-accent bg-accent text-white'
            : 'border border-border bg-bg-muted text-text-secondary hover:text-text-primary hover:border-border-hover'
        }`
        ;(b as HTMLElement).style.borderRadius = '3px'
      })

      let visibleCount = 0
      cards.forEach((card) => {
        const category = (card as HTMLElement).dataset.category
        const show = filter === 'All' || category === filter
        ;(card as HTMLElement).style.display = show ? '' : 'none'
        if (show) visibleCount++
      })

      if (empty) {
        empty.classList.toggle('hidden', visibleCount > 0)
      }
      if (grid) {
        (grid as HTMLElement).classList.toggle('hidden', visibleCount === 0)
      }
    })
  })
</script>
