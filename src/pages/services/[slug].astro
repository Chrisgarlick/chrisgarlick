---
import Base from '../../layouts/Base.astro'
import SEO from '../../components/SEO.astro'
import BlockRenderer from '../../components/BlockRenderer.astro'
import { cms } from '../../lib/cms'

export async function getStaticPaths() {
  // Outcome verticals only. Industry-specific pages now live under /industries/[slug].
  const serviceSlugs = new Set([
    'workflow-automation',
    'ai-agents',
    'data-extraction',
    'ai-engineering',
    'ai-implementation',
  ])
  const client = cms()
  const result = await client.collection('page').findMany({ where: { status: 'published' }, limit: 500 })
  const pages = result?.data ?? []
  return pages.filter((p: any) => serviceSlugs.has(p.slug)).map((p: any) => ({ params: { slug: p.slug } }))
}

const { slug } = Astro.params
const client = cms()

let page: any = null
try {
  page = await client.collection('page').findOne({ where: { slug } })
} catch {}

if (!page) return Astro.redirect('/404')

const title = page.seo?.metaTitle || `${page.title} — Chris Garlick`
const description = page.seo?.metaDescription || ''
const seoKeywords = [
  page.seo?.focusKeyword,
  ...(page.seo?.secondaryKeywords ? page.seo.secondaryKeywords.split(',').map((k: string) => k.trim()) : []),
].filter(Boolean).join(', ') || undefined
const rawContent = page.content ?? []
const contentBlocks = typeof rawContent === 'string' ? JSON.parse(rawContent) : rawContent

const breadcrumbs = [
  { name: 'Home',     url: '/' },
  { name: 'Services', url: '/services' },
  { name: page.title, url: `/services/${slug}` },
]

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.title,
  description,
  url: `https://chrisgarlick.com/services/${slug}`,
  serviceType: 'AI Implementation',
  provider: {
    '@type': 'ProfessionalService',
    name: 'Chris Garlick',
    url: 'https://chrisgarlick.com',
    image: 'https://chrisgarlick.com/og/home.png',
    areaServed: { '@type': 'Country', name: 'United Kingdom' },
    address: { '@type': 'PostalAddress', addressCountry: 'GB' },
    founder: {
      '@type': 'Person',
      name: 'Chris Garlick',
      url: 'https://chrisgarlick.com/about',
    },
  },
  areaServed: [
    { '@type': 'Country', name: 'United Kingdom' },
    { '@type': 'AdministrativeArea', name: 'England' },
    { '@type': 'AdministrativeArea', name: 'Scotland' },
    { '@type': 'AdministrativeArea', name: 'Wales' },
    { '@type': 'AdministrativeArea', name: 'Northern Ireland' },
  ],
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'UK businesses and professional services firms',
    geographicArea: { '@type': 'Country', name: 'United Kingdom' },
  },
}

// The pillar page has an inline "Common questions" section — mirror those Q&As as FAQPage schema
// so search engines see them as a structured FAQ. Kept here (rather than parsed from body) to
// keep the schema authoritative and reviewable.
const PILLAR_FAQ = slug === 'ai-implementation' ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does an AI implementation project take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most builds run two to six weeks of focused work, with another two weeks of measure-and-iterate after go-live. The audit and scoping happen in week one. The actual build typically takes one to four weeks depending on integrations and scope.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does AI implementation cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Engagements start at £500 for a focused fix to a single bottleneck. Workflow automation builds with one or two integrations typically land between £2,000 and £8,000. Larger agent systems, custom integrations and ongoing retainers are quoted per project after scoping. Pricing is fixed before the build starts.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need existing technical infrastructure?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Most builds work with the systems you already use: Google Workspace or Microsoft 365, your CRM (Clio, HubSpot, Notion, Airtable, whatever), your accounting tool, your inbox. The point is to slot into how you already work, not to force a migration.',
      },
    },
    {
      '@type': 'Question',
      name: 'What if I don\'t know which workflow to automate first?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Run the free site audit and tell me which manual task is eating your week — we\'ll talk it through on a 30-minute call. The first build is always the one with the clearest ROI, and the audit\'s job is to surface that.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you work with non-UK businesses?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, but the bias is UK. Time-zone overlap matters when you\'re working with one person. Most clients are in the UK; some are in EU and US East Coast.',
      },
    },
  ],
} : null

// FAQ schema for the AI Engineering page. Mirrors the visible "Common questions"
// block on the page so Google sees both the rendered content and the structured data.
const AI_ENGINEERING_FAQ = slug === 'ai-engineering' ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is AI engineering different from AI implementation?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'AI implementation is the outcome: scope, build, deliver a working system that replaces manual work. AI engineering is the craft you bring to that project beyond writing prompts. Choosing models, designing retrieval, evaluating outputs, instrumenting failure modes. The two travel together. You cannot have a reliable implementation without the engineering depth.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why do most of your builds use Claude rather than GPT or open-source models?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Claude Sonnet currently leads on the kind of work most clients need: nuanced reasoning over real documents, reliable tool use, instruction-following without rambling. GPT is competitive on a few specific tasks, like very long-context exact match. Open-weight models are gaining fast but mostly have not caught up on tool use and structured output yet. Model choice gets revisited at scoping every project. If a different model wins on cost or quality for your workload, that is what gets built.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can you run AI on our own servers instead of calling an API?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, with caveats. The standard stack for on-premises is Ollama for smaller deployments and vLLM for larger ones, running open-weight models from the Llama, Mistral, Qwen or Gemma families. I have used Ollama with Gemma locally for prototyping. I have not deployed an on-premises model to production yet. For most builds the answer is a managed-cloud API with a properly scoped data-processing agreement and zero-retention mode, rather than self-hosted. Where compliance genuinely requires self-hosted, the stack above is the plan.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is RAG and do I need it?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Retrieval-augmented generation. Instead of relying on what the model learned at training time, you give the model your documents at query time. The model still does the language work. A search system finds the relevant chunks first. You need it whenever the right answer is in your data rather than the model\'s training data: internal knowledge bases, policy lookup, contract Q&A, document search at scale.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long does an AI engineering build take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most engineering-heavy builds run four to eight weeks. The first week is scoping and stack selection. The next two to four weeks are the build. The last week or two is evaluation, observability setup and handover. Smaller targeted engagements, like a single workflow or single model integration, can run two to four weeks total.',
      },
    },
  ],
} : null

const faqLd = PILLAR_FAQ || AI_ENGINEERING_FAQ
const jsonLd = [serviceLd, ...(faqLd ? [faqLd] : [])]
---

<Base>
  <SEO
    slot="head"
    title={title}
    description={description}
    keywords={seoKeywords}
    ogType={page.seo?.ogType || 'website'}
    ogTitle={page.seo?.ogTitle}
    ogDescription={page.seo?.ogDescription}
    ogImage={page.seo?.ogImage}
    breadcrumbs={breadcrumbs}
    author="Chris Garlick"
    jsonLd={jsonLd}
  />

  <BlockRenderer blocks={contentBlocks} />
</Base>
