---
import Base from '../layouts/Base.astro'
import SEO from '../components/SEO.astro'
---

<Base bare={true}>
  <SEO
    slot="head"
    title="Find the one task costing you the most time | Chris Garlick"
    description="Free site audit, 24-hour report, 30-minute review call. One person, one focused look at where AI can save you real hours. No agency overhead, no pitch deck."
    canonical="https://chrisgarlick.com/start"
    keywords="ai audit, ai automation audit, business workflow audit, free ai consultation uk, automate manual tasks, ai implementation audit"
    noindex={true}
    jsonLd={{
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Start with a free site and workflow audit',
      url: 'https://chrisgarlick.com/start',
      description: 'A no-commitment audit of your site and workflow, surfacing the single highest-value task to automate first.',
    }}
  />

  <section class="min-h-[100dvh] flex items-center">
    <div class="mx-auto w-full max-w-[680px] px-5 py-16 md:px-8 md:py-24">

      <!-- Eyebrow -->
      <p class="mb-5 font-body text-[11px] font-medium uppercase tracking-[0.18em] text-accent">
        For founders &amp; operators
      </p>

      <!-- Hero -->
      <h1 class="mb-5 font-display text-[40px] leading-[1.05] text-text-primary md:text-[56px]">
        Let&rsquo;s find the one task that&rsquo;s costing you the most time.
      </h1>

      <p class="mb-12 max-w-[560px] text-[16px] leading-[1.7] text-text-secondary md:text-[17px]">
        I&rsquo;ll audit your site and surface the single highest-value workflow to automate first. No pitch. No deck. Just the one specific thing I&rsquo;d build if you were my client.
      </p>

      <!-- How it works — 3 steps -->
      <div class="mb-12 space-y-5 border-l-2 border-accent pl-6 md:pl-7">
        <div>
          <p class="mb-1 font-body text-[11px] font-medium uppercase tracking-[0.16em] text-accent">Step 01</p>
          <p class="font-display text-[18px] leading-[1.4] text-text-primary md:text-[20px]">
            Drop your URL. Get a free technical and workflow audit back within 24 hours.
          </p>
        </div>
        <div>
          <p class="mb-1 font-body text-[11px] font-medium uppercase tracking-[0.16em] text-accent">Step 02</p>
          <p class="font-display text-[18px] leading-[1.4] text-text-primary md:text-[20px]">
            I&rsquo;ll surface one specific automation worth building &mdash; the bottleneck I&rsquo;d remove first.
          </p>
        </div>
        <div>
          <p class="mb-1 font-body text-[11px] font-medium uppercase tracking-[0.16em] text-accent">Step 03</p>
          <p class="font-display text-[18px] leading-[1.4] text-text-primary md:text-[20px]">
            30-minute call to walk you through it. If it&rsquo;s not worth doing, I&rsquo;ll say so.
          </p>
        </div>
      </div>

      <!-- Single CTA -->
      <div class="mb-10">
        <a
          href="/tools/site-audit"
          class="inline-flex items-center gap-3 border border-accent bg-accent px-7 py-4 font-body text-[14px] font-medium uppercase tracking-[0.12em] text-white no-underline transition-all duration-150 hover:bg-accent-hover hover:border-accent-hover"
          style="border-radius: 3px;"
          data-cta="start-primary"
        >
          Run your free audit
          <span aria-hidden="true">&rarr;</span>
        </a>
        <p class="mt-3 font-body text-[12px] text-text-tertiary">
          Free. No card. No follow-up if you&rsquo;d rather not.
        </p>
      </div>

      <!-- Proof — one line, no fabrication -->
      <div class="border-t border-border pt-8">
        <p class="font-body text-[13px] leading-[1.7] text-text-secondary">
          <span class="font-display text-text-primary">One-person AI partner.</span>
          No account managers, no junior handoffs, no brief-to-delivery translation loss. The work goes straight from me to you &mdash; including the audit tool you&rsquo;re about to use, this site, and every system I ship for clients.
        </p>
      </div>

    </div>
  </section>
</Base>

<script>
  ;(window as any).dataLayer = (window as any).dataLayer || []
  ;(window as any).dataLayer.push({ event: 'start_page_view' })

  document.querySelector('[data-cta="start-primary"]')?.addEventListener('click', () => {
    ;(window as any).dataLayer.push({ event: 'start_cta_click', cta: 'free_audit' })
  })
</script>
