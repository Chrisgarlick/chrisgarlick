---
import Base from '../layouts/Base.astro'
import SEO from '../components/SEO.astro'
import BlockRenderer from '../components/BlockRenderer.astro'
import { cms } from '../lib/cms'

const client = cms()

let page: any = null
try {
  page = await client.collection('page').findOne({ where: { slug: 'about' } })
} catch {}

const title = page?.seo?.metaTitle || 'About Chris Garlick | Solo AI Developer for Professional Services'
const description = page?.seo?.metaDescription || 'Solo AI developer building workflow automation for law firms, agencies, and accountancy practices. Proprietary tools, fixed pricing, no juniors on your project.'
const seoKeywords = [
  page?.seo?.focusKeyword,
  ...(page?.seo?.secondaryKeywords ? page.seo.secondaryKeywords.split(',').map((k: string) => k.trim()) : []),
].filter(Boolean).join(', ') || undefined
const rawContent = page?.content ?? []
const contentBlocks = typeof rawContent === 'string' ? JSON.parse(rawContent) : rawContent

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Chris Garlick',
  jobTitle: 'Software Developer',
  url: 'https://chrisgarlick.com/about',
  knowsAbout: ['Artificial Intelligence', 'Workflow Automation', 'Legal Technology', 'Accounting Technology'],
  sameAs: [
    'https://www.linkedin.com/in/chrisgarlick',
    'https://github.com/Kritano',
  ],
}
---

<Base>
  <SEO
    slot="head"
    title={title}
    description={description}
    keywords={seoKeywords}
    ogImage="https://chrisgarlick.com/media/8c33143e-3e47-4a77-bf47-128f5c674a1f.webp"
    jsonLd={jsonLd}
  />

  {contentBlocks.length > 0 ? (
    <BlockRenderer blocks={contentBlocks} />
  ) : (
    <section class="flex min-h-[60vh] items-center justify-center pt-16">
      <div class="mx-auto max-w-[720px] px-5 text-center md:px-8">
        <h1 class="mb-4 font-display text-4xl text-text-primary">About</h1>
        <p class="text-base text-text-secondary">
          Create a page with slug "about" in the <a href="/admin" class="text-accent hover:text-accent-hover">CMS admin</a> and add blocks to build this page.
        </p>
      </div>
    </section>
  )}
</Base>
