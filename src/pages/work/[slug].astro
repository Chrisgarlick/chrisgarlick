---
import Base from '../../layouts/Base.astro'
import SEO from '../../components/SEO.astro'
import CTASection from '../../components/CTASection.astro'
import { cms, formatDate, tiptapToHtml } from '../../lib/cms'

const { slug } = Astro.params
const client = cms()

const doc = await client.collection('caseStudy').findOne({ where: { slug } })
if (!doc) return Astro.redirect('/404')

// Get prev/next for navigation
const allCases = await client.collection('caseStudy').findMany({
  where: { status: 'published' },
  orderBy: { publishedAt: 'desc' },
  limit: 100,
})

const cases = allCases?.data ?? []
const currentIndex = cases.findIndex((c) => c.slug === slug)
const prev = currentIndex < cases.length - 1 ? cases[currentIndex + 1] : null
const next = currentIndex > 0 ? cases[currentIndex - 1] : null

// Body may be JSON string, object with .html, or TipTap JSON
const rawBody = typeof doc.body === 'string' ? JSON.parse(doc.body) : doc.body
const bodyHtml = rawBody?.html || tiptapToHtml(rawBody)

const seoTitle = doc.seo?.metaTitle || `${doc.title} — AI Case Study — Chris Garlick`
const seoDesc = doc.seo?.metaDescription || doc.summary?.slice(0, 155) || ''

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: doc.title,
  description: doc.summary || '',
  author: { '@type': 'Person', name: 'Chris Garlick' },
  datePublished: doc.publishedAt || '',
}
---

<Base>
  <SEO
    slot="head"
    title={seoTitle}
    description={seoDesc}
    jsonLd={jsonLd}
  />

  <article class="py-20 md:py-24">
    <div class="mx-auto max-w-[720px] px-5 md:px-8">
      <!-- Header -->
      <div class="mb-12">
        <div class="mb-4 flex items-center gap-3">
          <span class="rounded-[3px] bg-bg-muted px-2.5 py-1 font-body text-xs font-medium uppercase tracking-widest text-text-secondary">
            {doc.category}
          </span>
          <span class="text-sm text-text-secondary">{formatDate(doc.publishedAt)}</span>
        </div>
        <h1 class="mb-4 font-display text-[36px] leading-[1.15] text-text-primary md:text-[48px]">{doc.title}</h1>
        {doc.result && (
          <p class="text-xl text-accent md:text-2xl">{doc.result}</p>
        )}
      </div>

      <!-- Stats row -->
      <div class="mb-12 grid grid-cols-3 gap-4 border border-border bg-bg-surface p-6" style="border-radius: 3px;">
        {doc.duration && (
          <div>
            <p class="mb-1 font-body text-xs font-medium uppercase tracking-widest text-text-tertiary">Duration</p>
            <p class="text-sm text-text-primary">{doc.duration}</p>
          </div>
        )}
        {doc.tier && (
          <div>
            <p class="mb-1 font-body text-xs font-medium uppercase tracking-widest text-text-tertiary">Engagement</p>
            <p class="text-sm text-text-primary">{doc.tier}</p>
          </div>
        )}
        {doc.result && (
          <div>
            <p class="mb-1 font-body text-xs font-medium uppercase tracking-widest text-text-tertiary">Result</p>
            <p class="text-sm text-accent">{doc.result}</p>
          </div>
        )}
      </div>

      <!-- Body -->
      {bodyHtml && (
        <div class="prose-custom text-base leading-[1.75] text-text-secondary" set:html={bodyHtml} />
      )}

      <!-- Prev / Next -->
      <div class="mt-16 grid gap-4 border-t border-border pt-8 md:grid-cols-2">
        {prev && (
          <a
            href={`/work/${prev.slug}`}
            class="border border-border p-4 no-underline transition-all duration-200 hover:border-border-hover hover:bg-bg-surface"
            style="border-radius: 3px;"
          >
            <p class="mb-1 text-xs uppercase tracking-widest text-text-tertiary">&larr; Previous</p>
            <p class="text-sm text-text-primary">{prev.title}</p>
          </a>
        )}
        {next && (
          <a
            href={`/work/${next.slug}`}
            class="border border-border p-4 no-underline transition-all duration-200 hover:border-border-hover hover:bg-bg-surface md:text-right"
            style="border-radius: 3px;"
          >
            <p class="mb-1 text-xs uppercase tracking-widest text-text-tertiary">Next &rarr;</p>
            <p class="text-sm text-text-primary">{next.title}</p>
          </a>
        )}
      </div>
    </div>
  </article>

  <CTASection />
</Base>
