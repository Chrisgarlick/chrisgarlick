---
import Base from '../../layouts/Base.astro'
import SEO from '../../components/SEO.astro'
---

<Base>
  <SEO
    slot="head"
    title="Delete your audit data | Chris Garlick"
    description="Self-serve removal of your AI readiness audit data. One click."
    canonical="https://chrisgarlick.com/data/delete"
    noindex={true}
  />

  <section class="py-16 md:py-24">
    <div class="mx-auto w-full max-w-[640px] px-5 md:px-8">

      <p class="mb-3 font-body text-[11px] font-medium uppercase tracking-[0.18em] text-accent">
        Data deletion
      </p>
      <h1 class="mb-5 font-display text-[36px] leading-[1.1] text-text-primary md:text-[44px]">
        Remove your audit data.
      </h1>

      <!-- ── Loading state ─────────────────────────────────────── -->
      <div id="delete-loading" class="mb-8">
        <p class="text-[15px] leading-[1.7] text-text-secondary">Checking your link&hellip;</p>
      </div>

      <!-- ── Invalid/expired link ──────────────────────────────── -->
      <div id="delete-invalid" class="hidden mb-8">
        <p class="mb-4 text-[15px] leading-[1.7] text-text-secondary">
          This link is invalid, expired, or doesn&rsquo;t match a submission.
        </p>
        <p class="text-[15px] leading-[1.7] text-text-secondary">
          If you&rsquo;d like your data removed and the link isn&rsquo;t working, email <a href="mailto:privacy@chrisgarlick.com" class="text-accent hover:text-accent-hover">privacy@chrisgarlick.com</a> with the email address you used and I&rsquo;ll action it within 30 days.
        </p>
      </div>

      <!-- ── Already deleted ───────────────────────────────────── -->
      <div id="delete-already" class="hidden mb-8 border-l-2 border-accent pl-6 md:pl-7">
        <p class="mb-2 font-body text-[11px] font-medium uppercase tracking-[0.18em] text-accent">Already removed</p>
        <h2 class="mb-3 font-display text-[24px] text-text-primary">Your data has already been deleted.</h2>
        <p class="text-[15px] leading-[1.7] text-text-secondary">
          Nothing else to do. Your submission was removed previously.
        </p>
      </div>

      <!-- ── Confirmation prompt ───────────────────────────────── -->
      <div id="delete-prompt" class="hidden">
        <p class="mb-6 text-[15px] leading-[1.7] text-text-secondary md:text-[16px]">
          You&rsquo;re about to remove the following audit submission from our records:
        </p>

        <div class="mb-8 border border-border bg-bg-surface p-5 md:p-6" style="border-radius: 3px;">
          <dl class="grid grid-cols-[120px_1fr] gap-y-2 font-body text-[13px]">
            <dt class="text-text-tertiary uppercase tracking-widest">Ref</dt>
            <dd class="text-text-primary" id="meta-ref"></dd>
            <dt class="text-text-tertiary uppercase tracking-widest">Email</dt>
            <dd class="text-text-primary" id="meta-email"></dd>
            <dt class="text-text-tertiary uppercase tracking-widest">Name</dt>
            <dd class="text-text-primary" id="meta-name"></dd>
            <dt class="text-text-tertiary uppercase tracking-widest">Company</dt>
            <dd class="text-text-primary" id="meta-company"></dd>
            <dt class="text-text-tertiary uppercase tracking-widest">Submitted</dt>
            <dd class="text-text-primary" id="meta-submitted"></dd>
          </dl>
        </div>

        <p class="mb-6 text-[14px] leading-[1.6] text-text-secondary">
          This deletes the submission, the generated audit PDF (if any), and all associated personal data. It can&rsquo;t be undone.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <button type="button" id="confirm-btn" class="delete-primary-btn">
            Yes, delete my data
          </button>
          <a href="/" class="font-body text-[13px] uppercase tracking-wider text-text-secondary no-underline hover:text-text-primary">
            Cancel
          </a>
        </div>

        <p id="delete-error" class="hidden mt-4 font-body text-[13px] text-red-600"></p>
      </div>

      <!-- ── Success ───────────────────────────────────────────── -->
      <div id="delete-success" class="hidden border-l-2 border-accent pl-6 md:pl-7">
        <p class="mb-2 font-body text-[11px] font-medium uppercase tracking-[0.18em] text-accent">Done</p>
        <h2 class="mb-3 font-display text-[24px] text-text-primary md:text-[28px]">
          Your data has been removed.
        </h2>
        <p class="mb-4 text-[15px] leading-[1.7] text-text-secondary">
          The submission, any generated audit PDF, and all associated personal data have been deleted. You will not receive any further contact about this enquiry.
        </p>
        <p class="text-[14px] leading-[1.6] text-text-tertiary">
          If you change your mind in the future, just <a href="/audit" class="text-accent hover:text-accent-hover">start a new audit</a> — there&rsquo;s no record of this one to interfere.
        </p>
      </div>

    </div>
  </section>
</Base>

<style>
  .delete-primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.75rem;
    border: 1px solid var(--color-destructive);
    border-radius: 3px;
    background: var(--color-destructive);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fff;
    cursor: pointer;
    transition: all 0.15s;
  }
  .delete-primary-btn:hover { opacity: 0.9; }
  .delete-primary-btn:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<script>
  const params = new URLSearchParams(window.location.search)
  const token = params.get('t')

  const els = {
    loading: document.getElementById('delete-loading')!,
    invalid: document.getElementById('delete-invalid')!,
    already: document.getElementById('delete-already')!,
    prompt:  document.getElementById('delete-prompt')!,
    success: document.getElementById('delete-success')!,
    error:   document.getElementById('delete-error')!,
    confirm: document.getElementById('confirm-btn') as HTMLButtonElement,
    meta: {
      ref:       document.getElementById('meta-ref')!,
      email:     document.getElementById('meta-email')!,
      name:      document.getElementById('meta-name')!,
      company:   document.getElementById('meta-company')!,
      submitted: document.getElementById('meta-submitted')!,
    },
  }

  const show = (el: HTMLElement) => el.classList.remove('hidden')
  const hide = (el: HTMLElement) => el.classList.add('hidden')

  function fmtDate(iso: string): string {
    try {
      return new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })
    } catch { return iso }
  }

  async function init() {
    if (!token) {
      hide(els.loading)
      show(els.invalid)
      return
    }

    try {
      const res = await fetch(`/api/audit/preview-delete?t=${encodeURIComponent(token)}`)
      const data = await res.json()
      hide(els.loading)

      if (!res.ok) {
        show(els.invalid)
        return
      }
      if (data.alreadyDeleted) {
        show(els.already)
        return
      }

      els.meta.ref.textContent       = data.auditRef
      els.meta.email.textContent     = data.email
      els.meta.name.textContent      = data.name || '—'
      els.meta.company.textContent   = data.companyName || '—'
      els.meta.submitted.textContent = fmtDate(data.submittedAt)
      show(els.prompt)
    } catch (err) {
      hide(els.loading)
      show(els.invalid)
    }
  }

  els.confirm?.addEventListener('click', async () => {
    hide(els.error)
    els.confirm.disabled = true
    const originalLabel = els.confirm.textContent
    els.confirm.textContent = 'Removing…'

    try {
      const res = await fetch('/api/audit/confirm-delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ t: token }),
      })
      const data = await res.json().catch(() => ({}))

      if (!res.ok) {
        els.error.textContent = data.error || 'Could not complete deletion. Please email privacy@chrisgarlick.com.'
        show(els.error)
        els.confirm.disabled = false
        els.confirm.textContent = originalLabel
        return
      }

      hide(els.prompt)
      show(els.success)
      window.scrollTo({ top: 0, behavior: 'smooth' })
    } catch {
      els.error.textContent = 'Network error. Please try again or email privacy@chrisgarlick.com.'
      show(els.error)
      els.confirm.disabled = false
      els.confirm.textContent = originalLabel
    }
  })

  init()
</script>
