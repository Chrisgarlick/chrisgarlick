---
import Base from '../../layouts/Base.astro'
import SEO from '../../components/SEO.astro'
import BlockRenderer from '../../components/BlockRenderer.astro'
import { cms } from '../../lib/cms'

export async function getStaticPaths() {
  const client = cms()
  const result = await client.collection('page').findMany({ where: { status: 'published' }, limit: 500 })
  const pages = result?.data ?? []
  const reservedSlugs = ['home', 'about', 'contact', 'services', 'industries', 'ai-implementation', 'workflow-automation', 'ai-agents', 'data-extraction', 'ai-engineering', 'ai-for-law-firms', 'ai-for-agencies', 'ai-for-accountancy-firms']
  return pages.filter((p: any) => !reservedSlugs.includes(p.slug)).map((p: any) => ({ params: { slug: p.slug } }))
}

const { slug } = Astro.params
const client = cms()

let page: any = null
try {
  page = await client.collection('page').findOne({ where: { slug } })
} catch {}

// Pages with reserved slugs are handled by their own routes
const reservedSlugs = ['home', 'about', 'contact', 'services', 'industries', 'ai-implementation', 'workflow-automation', 'ai-agents', 'data-extraction', 'ai-engineering', 'ai-for-law-firms', 'ai-for-agencies', 'ai-for-accountancy-firms']
if (!page || reservedSlugs.includes(slug!)) {
  return Astro.redirect('/404')
}

const title = page.seo?.metaTitle || `${page.title} — Chris Garlick`
const description = page.seo?.metaDescription || ''
const rawContent = page.content ?? []
const contentBlocks = typeof rawContent === 'string' ? JSON.parse(rawContent) : rawContent
---

<Base>
  <SEO
    slot="head"
    title={title}
    description={description}
  />

  <BlockRenderer blocks={contentBlocks} />
</Base>
