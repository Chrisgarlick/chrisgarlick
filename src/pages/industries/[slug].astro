---
import Base from '../../layouts/Base.astro'
import SEO from '../../components/SEO.astro'
import BlockRenderer from '../../components/BlockRenderer.astro'
import ForCrossLink from '../../components/ForCrossLink.astro'
import { cms } from '../../lib/cms'

const INDUSTRY_SLUGS = new Set([
  'ai-for-law-firms',
  'ai-for-accountancy-firms',
  'ai-for-agencies',
])

// Operating-model cross-links per industry. /industries/ is the sector axis,
// /for/ is the operating-model axis. They're orthogonal — a sole-practice
// solicitor sees both pages and both fit.
const FOR_CROSS_LINK: Record<string, { slug: string; label: string; framing: string }> = {
  'ai-for-law-firms': {
    slug: 'solo-operators',
    label: 'Solo operators',
    framing: 'Sole practitioners and one-partner firms run on a different operating model than mid-sized practices. The Solo Operator stack covers content, follow-ups, reviews and SEO blogging on a two-hour-a-day admin budget.',
  },
  'ai-for-accountancy-firms': {
    slug: 'solo-operators',
    label: 'Solo operators',
    framing: 'Sole-practice accountants face the same operating-model problem as one-person consultancies: not enough hours for the work that compounds. The Solo Operator stack is built for that constraint.',
  },
  'ai-for-agencies': {
    slug: 'agency-starters',
    label: 'Agency starters',
    framing: 'If you\'re building an agency from scratch (or considering it) rather than running an established one, the Zero-Team Agency Playbook covers the small-team-with-AI-stack pattern that makes the first ten clients viable as a solo founder.',
  },
}

export async function getStaticPaths() {
  const slugs = ['ai-for-law-firms', 'ai-for-accountancy-firms', 'ai-for-agencies']
  const client = cms()
  const result = await client.collection('page').findMany({ where: { status: 'published' }, limit: 500 })
  const pages = result?.data ?? []
  return pages.filter((p: any) => slugs.includes(p.slug)).map((p: any) => ({ params: { slug: p.slug } }))
}

const { slug } = Astro.params
if (!INDUSTRY_SLUGS.has(slug as string)) return Astro.redirect('/404')

const client = cms()

let page: any = null
try {
  page = await client.collection('page').findOne({ where: { slug } })
} catch {}

if (!page) return Astro.redirect('/404')

const title = page.seo?.metaTitle || `${page.title} — Chris Garlick`
const description = page.seo?.metaDescription || ''
const seoKeywords = [
  page.seo?.focusKeyword,
  ...(page.seo?.secondaryKeywords ? page.seo.secondaryKeywords.split(',').map((k: string) => k.trim()) : []),
].filter(Boolean).join(', ') || undefined
const rawContent = page.content ?? []
const contentBlocks = typeof rawContent === 'string' ? JSON.parse(rawContent) : rawContent

const breadcrumbs = [
  { name: 'Home',       url: '/' },
  { name: 'Industries', url: '/industries' },
  { name: page.title,   url: `/industries/${slug}` },
]

const audienceType = slug === 'ai-for-law-firms' ? 'UK law firms and solicitors'
                   : slug === 'ai-for-accountancy-firms' ? 'UK accountancy practices and chartered accountants'
                   : 'UK marketing, design and content agencies'

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.title,
  description,
  url: `https://chrisgarlick.com/industries/${slug}`,
  serviceType: 'AI Implementation',
  provider: {
    '@type': 'ProfessionalService',
    name: 'Chris Garlick',
    url: 'https://chrisgarlick.com',
    image: 'https://chrisgarlick.com/og/home.png',
    areaServed: { '@type': 'Country', name: 'United Kingdom' },
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'GB',
    },
    founder: {
      '@type': 'Person',
      name: 'Chris Garlick',
      url: 'https://chrisgarlick.com/about',
    },
  },
  areaServed: [
    { '@type': 'Country', name: 'United Kingdom' },
    { '@type': 'AdministrativeArea', name: 'England' },
    { '@type': 'AdministrativeArea', name: 'Scotland' },
    { '@type': 'AdministrativeArea', name: 'Wales' },
    { '@type': 'AdministrativeArea', name: 'Northern Ireland' },
  ],
  audience: {
    '@type': 'BusinessAudience',
    audienceType,
    geographicArea: { '@type': 'Country', name: 'United Kingdom' },
  },
}
---

<Base>
  <SEO
    slot="head"
    title={title}
    description={description}
    keywords={seoKeywords}
    ogType={page.seo?.ogType || 'website'}
    ogTitle={page.seo?.ogTitle}
    ogDescription={page.seo?.ogDescription}
    ogImage={page.seo?.ogImage}
    breadcrumbs={breadcrumbs}
    author="Chris Garlick"
    jsonLd={serviceLd}
  />

  <BlockRenderer blocks={contentBlocks} />

  {FOR_CROSS_LINK[slug as string] && (
    <ForCrossLink
      audienceSlug={FOR_CROSS_LINK[slug as string].slug}
      audienceLabel={FOR_CROSS_LINK[slug as string].label}
      framing={FOR_CROSS_LINK[slug as string].framing}
    />
  )}
</Base>
