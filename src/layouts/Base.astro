---
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body class={`min-h-screen bg-bg-primary text-text-primary ${className ?? ''}`}>
    <Nav />
    <main id="main" class="pt-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>
