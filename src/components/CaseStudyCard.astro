---
interface Props {
  slug: string
  category?: string
  title: string
  result?: string
  summary?: string
  publishedAt?: string
}

const { slug, category, title, result, summary, publishedAt } = Astro.props
---

<a
  href={`/work/${slug}`}
  class="card-hover group block border border-border bg-bg-surface p-7 no-underline md:p-8"
  style="border-radius: 3px;"
>
  <div class="mb-4 flex items-center gap-3">
    {category && (
      <span class="font-body text-[11px] font-medium uppercase tracking-[0.14em] text-accent">
        {category}
      </span>
    )}
    {publishedAt && (
      <span class="text-[12px] text-text-tertiary">{new Date(publishedAt).getFullYear()}</span>
    )}
  </div>
  <h3 class="mb-2 font-display text-[1.25rem] text-text-primary transition-colors group-hover:text-accent">
    {title}
  </h3>
  {result && (
    <p class="mb-3 font-body text-[14px] font-medium text-accent">{result}</p>
  )}
  {summary && (
    <p class="text-[14px] leading-relaxed text-text-secondary">{summary}</p>
  )}
</a>
