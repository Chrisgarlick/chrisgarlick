---
interface Props {
  name: string
  priceRange: string
  duration: string
  type: string
  includes: string[]
}

const { name, priceRange, duration, type, includes } = Astro.props
---

<div class="border border-border bg-bg-surface p-6 md:p-8" style="border-radius: 3px;">
  <h4 class="mb-2 font-body text-xs font-medium uppercase tracking-widest text-text-secondary">{type}</h4>
  <h3 class="mb-1 font-display text-[28px] text-text-primary md:text-4xl">{name}</h3>
  <p class="mb-1 font-body text-lg text-accent">{priceRange}</p>
  <p class="mb-6 text-sm text-text-secondary">{duration}</p>
  <ul class="space-y-3">
    {includes.map((item) => (
      <li class="flex items-start gap-3 text-sm text-text-secondary">
        <span class="mt-1 text-accent" aria-hidden="true">&bull;</span>
        {item}
      </li>
    ))}
  </ul>
</div>
