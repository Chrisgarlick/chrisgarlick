---
const currentPath = Astro.url.pathname

const links = [
  {
    href: '/services',
    label: 'Services',
    children: [
      { href: '/services/ai-implementation',        label: 'AI Implementation' },
      { href: '/services/workflow-automation',      label: 'Workflow Automation' },
      { href: '/services/ai-agents',                label: 'Custom AI Agents' },
      { href: '/services/data-extraction',          label: 'Data Extraction' },
      { href: '/services/ai-for-law-firms',         label: 'AI for Law Firms' },
      { href: '/services/ai-for-accountancy-firms', label: 'AI for Accountancy Firms' },
      { href: '/services/ai-for-agencies',          label: 'AI for Agencies' },
    ],
  },
  { href: '/work', label: 'Work' },
  {
    href: '/tools',
    label: 'Free',
    children: [
      { href: '/tools', label: 'Tools' },
      { href: '/resources', label: 'Resources' },
    ],
  },
  { href: '/article', label: 'Articles' },
  { href: '/about', label: 'About' },
]
---

<a href="#main" class="skip-to-content">Skip to content</a>

<nav
  class="fixed top-0 left-0 right-0 z-50 h-14"
  style="background: rgba(250,248,245,0.92); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: var(--shadow-nav);"
  aria-label="Main navigation"
>
  <div class="mx-auto flex h-full max-w-[1080px] items-center justify-between px-6 md:px-8">
    <!-- Wordmark -->
    <a
      href="/"
      class="font-display text-lg font-bold tracking-tight text-text-primary no-underline"
      aria-label="Chris Garlick — Home"
    >
      Chris Garlick<span class="text-accent">.</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-7 md:flex">
      {links.map(({ href, label, children }) => (
        children ? (
          <div class="nav-dropdown relative">
            <a
              href={href}
              class={`nav-link font-body text-[13px] tracking-wide uppercase no-underline transition-colors duration-150 ${
                currentPath.startsWith(href) ? 'text-text-primary active' : 'text-text-secondary hover:text-text-primary'
              }`}
            >
              {label}
              <svg class="ml-1 inline-block w-3 h-3 opacity-50" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 5l3 3 3-3"/></svg>
            </a>
            <div class="nav-dropdown-menu absolute left-0 top-full pt-2 hidden">
              <div class="min-w-[220px] border border-border bg-bg-surface py-2 shadow-lg" style="border-radius: 3px;">
                {children.map((child) => (
                  <a
                    href={child.href}
                    class={`block px-4 py-2 font-body text-[12px] tracking-wide no-underline transition-colors duration-150 ${
                      currentPath === child.href ? 'text-accent' : 'text-text-secondary hover:text-text-primary hover:bg-bg-muted'
                    }`}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={href}
            class={`nav-link font-body text-[13px] tracking-wide uppercase no-underline transition-colors duration-150 ${
              currentPath.startsWith(href) ? 'text-text-primary active' : 'text-text-secondary hover:text-text-primary'
            }`}
          >
            {label}
          </a>
        )
      ))}
      <a
        href="/contact"
        class="ml-1 inline-block border border-accent bg-accent px-5 py-2 font-body text-[13px] font-medium uppercase tracking-wider text-white no-underline transition-all duration-150 hover:bg-accent-hover hover:border-accent-hover"
        style="border-radius: 3px;"
      >
        Contact
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="nav-toggle"
      class="flex h-11 w-11 items-center justify-center text-text-primary md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7" />
        <line x1="4" y1="17" x2="20" y2="17" />
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile drawer -->
<div
  id="nav-drawer"
  class="fixed inset-0 z-50 hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <div id="nav-overlay" class="absolute inset-0" style="background: rgba(26,23,21,0.3);"></div>

  <div class="absolute right-0 top-0 flex h-full w-72 flex-col bg-bg-surface p-8 pt-20 shadow-2xl">
    <button
      id="nav-close"
      class="absolute right-5 top-4 flex h-11 w-11 items-center justify-center text-text-secondary hover:text-text-primary"
      aria-label="Close menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="18" y1="6" x2="6" y2="18" />
      </svg>
    </button>

    <div class="flex flex-col gap-5">
      {links.map(({ href, label, children }) => (
        <div>
          <a
            href={href}
            class={`font-body text-base uppercase tracking-wider no-underline ${
              currentPath.startsWith(href) ? 'text-accent' : 'text-text-secondary hover:text-text-primary'
            }`}
          >
            {label}
          </a>
          {children && (
            <div class="mt-2 ml-4 flex flex-col gap-2">
              {children.map((child) => (
                <a
                  href={child.href}
                  class={`font-body text-[13px] tracking-wide no-underline ${
                    currentPath === child.href ? 'text-accent' : 'text-text-tertiary hover:text-text-primary'
                  }`}
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="mt-auto">
      <a
        href="/contact"
        class="inline-block border border-accent bg-accent px-6 py-3 font-body text-[13px] font-medium uppercase tracking-wider text-white no-underline hover:bg-accent-hover"
        style="border-radius: 3px;"
      >
        Get in touch
      </a>
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById('nav-toggle')
  const drawer = document.getElementById('nav-drawer')
  const close = document.getElementById('nav-close')
  const overlay = document.getElementById('nav-overlay')

  function openDrawer() {
    drawer?.classList.remove('hidden')
    toggle?.setAttribute('aria-expanded', 'true')
    document.body.style.overflow = 'hidden'
  }

  function closeDrawer() {
    drawer?.classList.add('hidden')
    toggle?.setAttribute('aria-expanded', 'false')
    document.body.style.overflow = ''
  }

  toggle?.addEventListener('click', openDrawer)
  close?.addEventListener('click', closeDrawer)
  overlay?.addEventListener('click', closeDrawer)
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer() })

  // Desktop dropdown hover
  document.querySelectorAll('.nav-dropdown').forEach((el) => {
    const menu = el.querySelector('.nav-dropdown-menu')
    if (!menu) return
    let timeout: ReturnType<typeof setTimeout>
    el.addEventListener('mouseenter', () => { clearTimeout(timeout); menu.classList.remove('hidden') })
    el.addEventListener('mouseleave', () => { timeout = setTimeout(() => menu.classList.add('hidden'), 150) })
  })
</script>
