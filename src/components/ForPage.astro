---
import Base from '../layouts/Base.astro'
import SEO from './SEO.astro'

interface Workflow {
  workflow: string
  saving: string
  output: string
}

interface Sibling {
  slug: string
  label: string
}

interface Props {
  // Identity
  audience: string                       // "Agency starters"
  slug: string                           // "agency-starters" — final path segment
  // Hero
  eyebrow?: string                       // defaults to "For " + audience.toLowerCase()
  headline: string
  subhead?: string
  // Section 1: The thing you're not doing
  notDoing: string[]
  // Section 2: Why it matters
  whyItMatters: string
  // Section 3: Workflows
  workflows: Workflow[]
  // Section 4: What you get (optional, falls back to workflow outputs)
  whatYouGet?: string[]
  // CTA wiring
  resourceSlug: string
  resourceTitle: string
  resourceTeaser?: string
  // Cross-links
  relatedIndustry?: Sibling
  siblings?: Sibling[]                   // other /for/ audiences shown at the bottom
  // SEO
  seoTitle?: string
  seoDescription?: string
  seoKeywords?: string
}

const {
  audience,
  slug,
  eyebrow,
  headline,
  subhead,
  notDoing,
  whyItMatters,
  workflows,
  whatYouGet,
  resourceSlug,
  resourceTitle,
  resourceTeaser,
  relatedIndustry,
  siblings = [],
  seoTitle,
  seoDescription,
  seoKeywords,
} = Astro.props

const finalEyebrow = eyebrow || `For ${audience.toLowerCase()}`
const canonical = `https://chrisgarlick.com/for/${slug}`
const title = seoTitle || `AI for ${audience} | Chris Garlick`
const description = seoDescription || `${headline} ${subhead || ''}`.trim().slice(0, 158)

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'For',  url: '/for' },
  { name: audience, url: `/for/${slug}` },
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  inLanguage: 'en-GB',
  isPartOf: { '@type': 'WebSite', name: 'Chris Garlick', url: 'https://chrisgarlick.com' },
  about: { '@type': 'Audience', audienceType: audience },
  primaryImageOfPage: { '@type': 'ImageObject', url: 'https://chrisgarlick.com/og/home.png' },
}
---

<Base>
  <SEO
    slot="head"
    title={title}
    description={description}
    keywords={seoKeywords}
    canonical={canonical}
    breadcrumbs={breadcrumbs}
    jsonLd={jsonLd}
  />

  <article class="py-20 md:py-24">
    <div class="mx-auto max-w-[720px] px-5 md:px-8">

      <!-- Hero -->
      <header class="mb-16">
        <p class="mb-3 font-body text-[11px] font-medium uppercase tracking-[0.18em] text-accent">{finalEyebrow}</p>
        <h1 class="mb-5 font-display text-[36px] leading-[1.1] text-text-primary md:text-[48px]">{headline}</h1>
        {subhead && <p class="text-[16px] leading-[1.7] text-text-secondary md:text-[17px]">{subhead}</p>}
      </header>

      <!-- Section 1: The thing you're not doing -->
      <section class="mb-14">
        <p class="mb-3 font-body text-[11px] font-medium uppercase tracking-[0.18em] text-text-tertiary">01 / The thing you're not doing</p>
        <h2 class="mb-6 font-display text-[26px] leading-[1.2] text-text-primary md:text-[30px]">What's falling through the cracks.</h2>
        <ul class="space-y-3">
          {notDoing.map((item) => (
            <li class="flex items-start gap-3 text-[15px] leading-[1.6] text-text-secondary md:text-[16px]">
              <span class="mt-[7px] inline-block h-[6px] w-[6px] flex-shrink-0 bg-accent" style="border-radius: 1px;"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Section 2: Why it matters -->
      <section class="mb-14 border-l-[3px] border-accent bg-bg-muted py-6 pl-6 pr-5 md:py-7 md:pl-8">
        <p class="mb-3 font-body text-[11px] font-medium uppercase tracking-[0.18em] text-accent">02 / Why it matters</p>
        <p class="text-[16px] leading-[1.7] text-text-primary md:text-[17px]">{whyItMatters}</p>
      </section>

      <!-- Section 3: How AI does it -->
      <section class="mb-14">
        <p class="mb-3 font-body text-[11px] font-medium uppercase tracking-[0.18em] text-text-tertiary">03 / How AI does it</p>
        <h2 class="mb-6 font-display text-[26px] leading-[1.2] text-text-primary md:text-[30px]">The workflows worth building.</h2>

        <div class="border border-border bg-bg-surface" style="border-radius: 3px;">
          {workflows.map((w, i) => (
            <div class={`grid grid-cols-1 gap-3 px-5 py-5 md:grid-cols-[2fr_1fr_2fr] md:gap-6 md:px-6 md:py-6 ${i > 0 ? 'border-t border-border' : ''}`}>
              <div>
                <p class="mb-1 font-body text-[10px] font-medium uppercase tracking-[0.18em] text-text-tertiary md:hidden">Workflow</p>
                <p class="font-display text-[18px] leading-[1.3] text-text-primary md:text-[19px]">{w.workflow}</p>
              </div>
              <div class="md:border-l md:border-border md:pl-6">
                <p class="mb-1 font-body text-[10px] font-medium uppercase tracking-[0.18em] text-text-tertiary">Time saving</p>
                <p class="font-body text-[14px] leading-[1.5] text-accent">{w.saving}</p>
              </div>
              <div class="md:border-l md:border-border md:pl-6">
                <p class="mb-1 font-body text-[10px] font-medium uppercase tracking-[0.18em] text-text-tertiary">Output</p>
                <p class="font-body text-[14px] leading-[1.55] text-text-secondary">{w.output}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 4: What you get -->
      {whatYouGet && whatYouGet.length > 0 && (
        <section class="mb-14">
          <p class="mb-3 font-body text-[11px] font-medium uppercase tracking-[0.18em] text-text-tertiary">04 / What you get</p>
          <h2 class="mb-6 font-display text-[26px] leading-[1.2] text-text-primary md:text-[30px]">Concrete output, week one.</h2>
          <ul class="space-y-3">
            {whatYouGet.map((item) => (
              <li class="flex items-start gap-3 text-[15px] leading-[1.6] text-text-secondary md:text-[16px]">
                <span class="mt-[3px] flex-shrink-0 font-display text-[18px] leading-1 text-accent">&check;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Section 5: Primary CTA — gated resource -->
      <section class="mb-10 border border-accent bg-bg-surface p-7 md:p-9" style="border-radius: 3px;">
        <p class="mb-3 font-body text-[11px] font-medium uppercase tracking-[0.18em] text-accent">Free download</p>
        <h2 class="mb-3 font-display text-[26px] leading-[1.15] text-text-primary md:text-[30px]">{resourceTitle}</h2>
        {resourceTeaser && (
          <p class="mb-6 text-[15px] leading-[1.7] text-text-secondary md:text-[16px]">{resourceTeaser}</p>
        )}
        <a
          href={`/resources/${resourceSlug}`}
          class="inline-block border border-accent bg-accent px-5 py-3 font-body text-[13px] font-medium uppercase tracking-wider text-white no-underline transition-all duration-150 hover:bg-accent-hover hover:border-accent-hover"
          style="border-radius: 3px;"
        >
          Get the download &rarr;
        </a>
      </section>

      <!-- Secondary CTA: audit -->
      <section class="mb-14">
        <p class="text-[14px] leading-[1.7] text-text-secondary md:text-[15px]">
          Want a second opinion on your specific setup? <a href="/audit" class="text-accent no-underline hover:underline">Run the free AI audit</a>. Ten minutes, no pitch, you keep the report whether or not we work together.
        </p>
      </section>

      <!-- Cross-link to relevant industry, if any -->
      {relatedIndustry && (
        <section class="mb-14 border-t border-border pt-10">
          <p class="mb-2 font-body text-[11px] font-medium uppercase tracking-[0.18em] text-text-tertiary">Also relevant</p>
          <p class="text-[15px] leading-[1.7] text-text-secondary md:text-[16px]">
            Run in {relatedIndustry.label.toLowerCase()}?
            <a href={`/industries/${relatedIndustry.slug}`} class="text-accent no-underline hover:underline">
              See the sector-specific version &rarr;
            </a>
          </p>
        </section>
      )}

      <!-- Sibling /for/ pages -->
      {siblings.length > 0 && (
        <section class="border-t border-border pt-10">
          <p class="mb-5 font-body text-[11px] font-medium uppercase tracking-[0.18em] text-text-tertiary">For other operating models</p>
          <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
            {siblings.map((s) => (
              <a
                href={`/for/${s.slug}`}
                class="block border border-border bg-bg-surface px-5 py-4 font-body text-[14px] text-text-secondary no-underline transition-colors hover:text-text-primary hover:border-accent"
                style="border-radius: 3px;"
              >
                For {s.label.toLowerCase()} &rarr;
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </article>
</Base>
