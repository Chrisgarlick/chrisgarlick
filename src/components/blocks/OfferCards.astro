---
interface Props {
  card1Label?: string
  card1Name?: string
  card1Price?: string
  card1Duration?: string
  card1Features?: string
  card2Label?: string
  card2Name?: string
  card2Price?: string
  card2Duration?: string
  card2Features?: string
}

const props = Astro.props

const cards = [
  {
    label: props.card1Label,
    name: props.card1Name,
    price: props.card1Price,
    duration: props.card1Duration,
    features: props.card1Features?.split('\n').filter(Boolean) ?? [],
  },
  {
    label: props.card2Label,
    name: props.card2Name,
    price: props.card2Price,
    duration: props.card2Duration,
    features: props.card2Features?.split('\n').filter(Boolean) ?? [],
  },
].filter(c => c.name)
---

<section class="py-20 md:py-28">
  <div class="mx-auto max-w-[1080px] px-6 md:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {cards.map((card, i) => (
        <div
          class={`relative overflow-hidden border p-8 md:p-10 ${
            i === 0
              ? 'border-accent bg-accent-light'
              : 'border-border bg-bg-surface'
          }`}
          style="border-radius: 3px;"
        >
          {card.label && (
            <span class="mb-4 block font-body text-[11px] font-medium uppercase tracking-[0.16em] text-text-tertiary">
              {card.label}
            </span>
          )}
          <p class="font-display text-[1.75rem] text-text-primary">{card.price}</p>
          {card.duration && (
            <p class="mt-1 text-[13px] text-text-secondary">{card.duration}</p>
          )}
          {card.features.length > 0 && (
            <ul class="mt-7 space-y-3 border-t border-border pt-6">
              {card.features.map((f: string) => (
                <li class="flex items-start gap-3 text-[14px] leading-relaxed text-text-secondary">
                  <span class="mt-1.5 block h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
                  {f}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </div>
  <div class="mx-auto mt-20 max-w-[1080px] px-6 md:mt-28 md:px-8">
    <div class="h-px bg-border"></div>
  </div>
</section>
