---
interface Props {
  label?: string
  heading: string
  subtext?: string
  ctaLabel?: string
  ctaUrl?: string
  ctaSecondaryLabel?: string
  ctaSecondaryUrl?: string
}

const { label, heading, subtext, ctaLabel, ctaUrl, ctaSecondaryLabel, ctaSecondaryUrl } = Astro.props
---

<section class="relative overflow-hidden pt-14">
  <!-- Subtle geometric accent -->
  <div class="pointer-events-none absolute right-[-8%] top-[15%] h-[420px] w-[420px] rounded-full opacity-[0.04]"
    style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);"></div>

  <div class="mx-auto max-w-[1080px] px-6 py-24 md:px-8 md:py-36">
    {label && (
      <p class="animate-in mb-5 font-body text-[13px] font-medium uppercase tracking-[0.14em] text-accent">
        {label}
      </p>
    )}
    <h1 class="animate-in animate-delay-1 max-w-[680px] font-display text-[2.5rem] font-700 leading-[1.08] tracking-tight text-text-primary md:text-[3.75rem]">
      {heading}
    </h1>
    {subtext && (
      <p class="animate-in animate-delay-2 mt-7 max-w-[480px] text-[15px] leading-[1.75] text-text-secondary">
        {subtext}
      </p>
    )}
    {(ctaLabel || ctaSecondaryLabel) && (
      <div class="animate-in animate-delay-3 mt-10 flex flex-wrap items-center gap-5">
        {ctaLabel && ctaUrl && (
          <a
            href={ctaUrl}
            class="inline-block border border-accent bg-accent px-7 py-3 font-body text-[13px] font-medium uppercase tracking-wider text-white no-underline transition-all duration-150 hover:bg-accent-hover hover:border-accent-hover"
            style="border-radius: 3px;"
          >
            {ctaLabel}
          </a>
        )}
        {ctaSecondaryLabel && ctaSecondaryUrl && (
          <a
            href={ctaSecondaryUrl}
            class="inline-block border border-border bg-transparent px-7 py-3 font-body text-[13px] font-medium uppercase tracking-wider text-text-primary no-underline transition-all duration-150 hover:border-border-hover hover:bg-bg-muted"
            style="border-radius: 3px;"
          >
            {ctaSecondaryLabel}
          </a>
        )}
      </div>
    )}
  </div>

  <!-- Bottom rule -->
  <div class="mx-auto max-w-[1080px] px-6 md:px-8">
    <div class="h-px bg-border"></div>
  </div>
</section>
