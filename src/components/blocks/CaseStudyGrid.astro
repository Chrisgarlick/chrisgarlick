---
import CaseStudyCard from '../CaseStudyCard.astro'
import { cms } from '../../lib/cms'

interface Props {
  heading?: string
  subtext?: string
  limit?: number
  theme?: 'light' | 'dark'
}

const { heading, subtext, limit = 4, theme = 'light' } = Astro.props

const client = cms()
let cases: any[] = []

try {
  const res = await client.collection('caseStudy').findMany({
    where: { status: 'published' },
    orderBy: { publishedAt: 'desc' },
    limit,
  })
  cases = res?.data ?? []
} catch {}

if (cases.length === 0) return null
---

<section class="py-20 md:py-28" data-theme={theme}>
  <div class="mx-auto max-w-[1080px] px-6 md:px-8">
    {heading && (
      <div class="mb-12">
        <p class="mb-3 font-body text-[0.8125rem] font-medium uppercase tracking-[0.12em] text-text-tertiary">{heading}</p>
        {subtext && <p class="text-[15px] text-text-secondary">{subtext}</p>}
      </div>
    )}
    <div class="grid gap-6 md:grid-cols-2">
      {cases.map((study: any) => (
        <CaseStudyCard
          slug={study.slug}
          category={study.category}
          title={study.title}
          result={study.result}
          summary={study.summary}
          publishedAt={study.publishedAt}
        />
      ))}
    </div>
  </div>
  <div class="mx-auto mt-20 max-w-[1080px] px-6 md:mt-28 md:px-8">
    <div class="h-px bg-border"></div>
  </div>
</section>
