---
import { cms } from '../../lib/cms'

interface Props {
  label?: string
  tool1Name?: string
  tool1Body?: string
  tool2Name?: string
  tool2Body?: string
}

const { label, tool1Name, tool1Body, tool2Name, tool2Body } = Astro.props

// Try to fetch published tools from CMS
let cmsTools: any[] = []
try {
  const client = cms()
  const result = await client.collection('tool').findMany({
    where: { status: 'published' },
    orderBy: { sortOrder: 'asc' },
    limit: 2,
  })
  cmsTools = result?.data ?? []
} catch {}

// Use CMS tools if available, otherwise fall back to hardcoded props
const tools = cmsTools.length > 0
  ? cmsTools.map(t => ({ name: t.title, body: t.description, slug: t.slug, icon: t.icon }))
  : [
      { name: tool1Name, body: tool1Body, slug: null, icon: null },
      { name: tool2Name, body: tool2Body, slug: null, icon: null },
    ].filter(t => t.name)

if (tools.length === 0) return null
---

<section class="py-20 md:py-28">
  <div class="mx-auto max-w-[1080px] px-6 md:px-8">
    {label && <p class="mb-10 font-body text-[0.8125rem] font-medium uppercase tracking-[0.12em] text-text-tertiary">{label}</p>}
    <div class="grid gap-8 md:grid-cols-2 md:gap-12">
      {tools.map((tool) => {
        const inner = (
          <div class="border-l-2 border-accent pl-7">
            {tool.icon && <span class="mb-2 block text-xl">{tool.icon}</span>}
            <h3 class="mb-3 font-display text-[1.5rem] text-text-primary">{tool.name}</h3>
            {tool.body && (
              <p class="text-[15px] leading-[1.75] text-text-secondary">{tool.body}</p>
            )}
            {tool.slug && (
              <span class="mt-3 inline-block font-body text-[13px] font-medium text-accent">
                Try it free &rarr;
              </span>
            )}
          </div>
        )

        return tool.slug
          ? <a href={`/tools/${tool.slug}`} class="no-underline transition-opacity hover:opacity-80">{inner}</a>
          : inner
      })}
    </div>
    {cmsTools.length > 0 && (
      <div class="mt-10">
        <a href="/tools" class="font-body text-[13px] font-medium uppercase tracking-widest text-accent no-underline hover:text-accent-hover">
          View all tools &rarr;
        </a>
      </div>
    )}
  </div>
  <div class="mx-auto mt-20 max-w-[1080px] px-6 md:mt-28 md:px-8">
    <div class="h-px bg-border"></div>
  </div>
</section>
