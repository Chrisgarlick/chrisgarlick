---
import BlogRow from '../BlogRow.astro'
import { cms } from '../../lib/cms'

interface Props {
  heading?: string
  limit?: number
}

const { heading = 'Latest writing', limit = 3 } = Astro.props

const client = cms()
let posts: any[] = []

try {
  const res = await client.collection('article').findMany({
    where: { status: 'published' },
    orderBy: { publishedAt: 'desc' },
    limit,
  })
  posts = res?.data ?? []
} catch {}

if (posts.length === 0) return null
---

<section class="py-20 md:py-28">
  <div class="mx-auto max-w-[1080px] px-6 md:px-8">
    <p class="mb-10 font-body text-[0.8125rem] font-medium uppercase tracking-[0.12em] text-text-tertiary">{heading}</p>
    <div class="divide-y divide-border border-y border-border">
      {posts.map((post: any) => (
        <BlogRow slug={post.slug} title={post.title} publishedAt={post.publishedAt} />
      ))}
    </div>
    <a
      href="/article"
      class="mt-6 inline-block font-body text-[13px] text-accent no-underline transition-colors hover:text-accent-hover"
    >
      All posts →
    </a>
  </div>
  <div class="mx-auto mt-20 max-w-[1080px] px-6 md:mt-28 md:px-8">
    <div class="h-px bg-border"></div>
  </div>
</section>
