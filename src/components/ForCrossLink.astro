---
// A small section that cross-links from sector-axis pages (/industries/<x>) to
// the operating-model axis (/for/<y>). Rendered as a soft "you might also want"
// block — not the primary CTA, just an additional path through the site.
//
// Used by:
//   - src/pages/industries/[slug].astro (after BlockRenderer)
//   - anywhere else a sector-axis page wants to nudge towards an operating model

interface Props {
  audienceSlug: string                  // e.g. 'solo-operators'
  audienceLabel: string                 // e.g. 'Solo operators'
  framing: string                       // one short sentence explaining when this page's audience would also benefit
}

const { audienceSlug, audienceLabel, framing } = Astro.props
---

<section class="mx-auto max-w-[720px] px-5 pb-20 md:px-8 md:pb-24">
  <div class="border border-border bg-bg-surface p-7 md:p-9" style="border-radius: 3px;">
    <p class="mb-2 font-body text-[11px] font-medium uppercase tracking-[0.18em] text-accent">Also relevant</p>
    <h3 class="mb-3 font-display text-[22px] leading-[1.2] text-text-primary md:text-[26px]">
      For {audienceLabel.toLowerCase()}
    </h3>
    <p class="mb-5 text-[15px] leading-[1.7] text-text-secondary md:text-[16px]">{framing}</p>
    <a
      href={`/for/${audienceSlug}`}
      class="inline-block font-body text-[13px] font-medium uppercase tracking-wider text-accent no-underline hover:text-accent-hover"
    >
      See the {audienceLabel.toLowerCase()} playbook &rarr;
    </a>
  </div>
</section>
